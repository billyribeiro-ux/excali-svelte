{
  "name": "svelte-draw",
  "short_name": "svelte-draw",
  "description": "A virtual whiteboard that lets you sketch diagrams with a hand-drawn look and feel.",
  "start_url": "/",
  "id": "svelte-draw",
  "display": "standalone",
  "theme_color": "#121212",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "maskable_icon_x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/vnd.excalidraw+json": [
          ".excalidraw"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/web-share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.excalidraw+json",
            "application/json",
            ".excalidraw"
          ]
        }
      ]
    }
  }
}
