# svelte-draw runtime configuration (Vite env vars, read at build time).
#
# Copy to `.env.local` (or set in your host's build environment) and fill in
# the services YOU operate. EVERY variable is optional and defaults to EMPTY.
# An empty value disables the related feature and hides its UI; svelte-draw
# never falls back to any other organisation's server.
#
# Values are inlined into the client bundle: never put secrets here.

# --- Shareable links ("Export to link") -------------------------------------
# Base URLs of a compatible share-link backend (v2 API: GET `<GET_URL><id>`,
# POST `<POST_URL>` with the encrypted payload). Both are required.
# Unset: the "Export to link" button (export dialog) and the link section of
# the Share dialog are hidden; opening a `#json=` link reports an error.
# Images in shared links additionally need VITE_APP_FIREBASE_CONFIG.
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# --- Live collaboration -----------------------------------------------------
# socket.io server for real-time collaboration, e.g. http://localhost:3002
# AND the Firebase web-app config (single-line JSON, must contain
# `projectId`) used to persist scenes/files in Firestore + Storage.
# Both are required. Unset: "Live collaboration" (main menu, welcome screen,
# command palette, top-right Share button) is hidden and no room is joined.
VITE_APP_WS_SERVER_URL=
VITE_APP_FIREBASE_CONFIG=

# --- Public libraries -------------------------------------------------------
# Site where users browse/install libraries. Unset: the "Browse libraries"
# button is hidden and installing a library from a URL (`#addLibrary=`) is
# rejected. When set, only this site's hostname is accepted for URL installs.
VITE_APP_LIBRARY_URL=
# Base URL of the API accepting `POST <url>/submit` for "Publish library".
# Unset: "Publish library" is hidden.
VITE_APP_LIBRARY_BACKEND=

# --- AI (optional) ----------------------------------------------------------
# Base URL of an AI backend exposing /v1/ai/text-to-diagram/chat-streaming and
# /v1/ai/diagram-to-code/generate-streaming. Unset: text-to-diagram and
# diagram-to-code are not mounted (the Mermaid-to-diagram dialog still works).
VITE_APP_AI_BACKEND=

# --- Error reporting (optional) ---------------------------------------------
# Sentry DSN. Unset: Sentry is never initialised, nothing is reported and the
# error screen does not mention tracking.
VITE_APP_SENTRY_DSN=
# Release identifier attached to Sentry events (only used with a DSN).
VITE_APP_GIT_SHA=

# --- Misc -------------------------------------------------------------------
# Source repository used by the "GitHub" command (empty hides it).
# Default when unset: https://github.com/billyribeiro-ux/excali-svelte
# VITE_APP_REPOSITORY_URL=
# Set to "true" to disable the "unsaved changes" beforeunload prompt.
VITE_APP_DISABLE_PREVENT_UNLOAD=
# Set to "true" to emit usage events to a host-provided
# `window.svelteDrawTrack(action, data)` (no analytics service is bundled).
VITE_APP_ENABLE_TRACKING=
