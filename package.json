{
  "name": "svelte-draw",
  "private": true,
  "version": "0.1.0",
  "description": "svelte-draw: a hand-drawn virtual whiteboard built with Svelte 5 and SvelteKit",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter svelte-draw-app dev",
    "build": "pnpm --filter svelte-draw-app build",
    "preview": "pnpm --filter svelte-draw-app preview",
    "check": "pnpm --filter svelte-draw-app check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "locales-coverage": "node scripts/build-locales-coverage.js",
    "locales-coverage:description": "node scripts/locales-coverage-description.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/lodash.throttle": "4.1.7",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest-diff": "29.7.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "pepjs": "0.5.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sass": "1.106.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-canvas-mock": "1.2.0"
  }
}
